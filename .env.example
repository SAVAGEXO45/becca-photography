APP_NAME="BECCA PHOTOGRAPHY"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=becca_photography
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="SAVAGEXO@GMAIL.COM"
MAIL_FROM_NAME="${APP_NAME}"

BECCA_CONTACT_EMAIL="SAVAGEXO@GMAIL.COM"
BECCA_PHONE="+234 812 345 6789"
BECCA_STUDIO_LOCATION="The Foundry Studio, 14 Victoria Island Arts District, Lagos"
BECCA_INSTAGRAM="@beccaphotography"
BECCA_TWITTER="@beccaphotos"

VITE_APP_NAME="${APP_NAME}"
